# Telegram Bot Token (REQUIRED)
# Get it from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# AI Backend Keys (ALL OPTIONAL - bot uses fallback chain)
# Priority: HuggingFace → OpenRouter → Gemini

# HuggingFace API Key (first choice)
# Get from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# OpenRouter API Key (second choice)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini API Key (third choice)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Database URL (optional - defaults to SQLite)
DATABASE_URL=sqlite:///dating_bot.db
