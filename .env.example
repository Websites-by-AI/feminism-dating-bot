# Telegram Bot Token (REQUIRED for standalone polling mode; get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Cloudflare Edge RAG API (Live default works out of the box!)
CLOUDFLARE_API_URL=https://feminism-dating-api.elasa2next.workers.dev
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional Secondary AI Backend Keys
# Fallback chain: Cloudflare Workers AI RAG -> HuggingFace Router -> OpenRouter -> Gemini -> Local KB
HUGGINGFACE_API_KEY=
HUGGINGFACE_API_KEY_2=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Database URL (defaults to SQLite)
DATABASE_URL=sqlite:///dating_bot.db
